<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' && locale ? locale : 'en' %>" dir="<%= typeof dir !== 'undefined' && dir ? dir : 'ltr' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Islamic Calendar — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/style.css" />
  <style>
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 9999px; }
    .dot-festival { background: #10b981; }
    .dot-solemn { background: #818cf8; }
    .dot-night { background: #fbbf24; }
    .dot-observance { background: #38bdf8; }
    .dot-sunnah { background: #2dd4bf; }
    .day-cell.has-events { box-shadow: inset 0 0 0 1px rgba(16,185,129,0.35); border-radius: 0.75rem; }
    .day-cell[aria-expanded="true"] { box-shadow: inset 0 0 0 2px #10b981; }
  </style>
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { user, isAdmin: false }) %>
  <div class="container mx-auto px-4 pt-24 pb-12 max-w-3xl">

    <div class="mb-4">
      <h1 class="text-2xl font-bold text-white mb-1">Islamic Calendar</h1>
      <p class="text-slate-400 text-sm">Hijri dates and shared commemorations for <span class="text-slate-300"><%= user.city %>, <%= user.country %></span>. Dates can move by a day with the local moon — use the adjustment if your community sights differently.</p>
    </div>

    <!-- Month navigation -->
    <div class="flex items-center justify-between mb-2">
      <a href="/hijri?m=<%= prevParam %>&tradition=<%= tradition %>&adjust=<%= dayAdjust %>" aria-label="Previous month"
         class="w-10 h-10 rounded-xl bg-slate-900/70 border border-slate-800 hover:bg-slate-800 flex items-center justify-center text-slate-300">‹</a>
      <div class="text-center">
        <p class="text-white font-bold text-lg"><%= monthLabel %></p>
        <p class="text-emerald-300/90 text-sm">🌙 <%= hijriRange %> AH</p>
      </div>
      <a href="/hijri?m=<%= nextParam %>&tradition=<%= tradition %>&adjust=<%= dayAdjust %>" aria-label="Next month"
         class="w-10 h-10 rounded-xl bg-slate-900/70 border border-slate-800 hover:bg-slate-800 flex items-center justify-center text-slate-300">›</a>
    </div>
    <p class="text-center mb-4"><a href="/hijri?tradition=<%= tradition %>&adjust=<%= dayAdjust %>" class="text-xs text-slate-400 hover:text-emerald-400 underline">Jump to today</a></p>

    <!-- Tradition filter + moon-sighting adjustment -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-4 text-sm">
      <div class="flex rounded-xl border border-slate-800 overflow-hidden" role="group" aria-label="Filter events by tradition">
        <% ["sunni","shia","both"].forEach(function(tr){ %>
        <button type="button" data-tradition="<%= tr %>"
                class="trad-btn px-3.5 py-1.5 font-semibold transition-colors <%= tradition === tr ? 'bg-emerald-500 text-slate-950' : 'bg-slate-900/70 text-slate-300 hover:bg-slate-800' %>"
                aria-pressed="<%= tradition === tr %>"><%= tr === "both" ? "Both" : (tr === "sunni" ? "Sunni" : "Shia") %></button>
        <% }); %>
      </div>
      <div class="flex items-center gap-1.5 rounded-xl border border-slate-800 bg-slate-900/70 px-2 py-1" role="group" aria-label="Moon-sighting day adjustment">
        <span class="text-slate-400 pl-1">±</span>
        <% [-1, 0, 1].forEach(function(a){ %>
        <button type="button" data-adjust="<%= a %>"
                class="adj-btn px-2.5 py-0.5 rounded-lg font-semibold transition-colors <%= dayAdjust === a ? 'bg-indigo-500 text-white' : 'text-slate-300 hover:bg-slate-800' %>"
                aria-pressed="<%= dayAdjust === a %>"><%= a > 0 ? "+" + a : a %></button>
        <% }); %>
      </div>
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-slate-400 mb-4">
      <span><span class="dot dot-festival"></span> festival</span>
      <span><span class="dot dot-solemn"></span> solemn</span>
      <span><span class="dot dot-night"></span> night</span>
      <span><span class="dot dot-observance"></span> observance</span>
      <span><span class="dot dot-sunnah"></span> sunnah fast</span>
    </div>

    <!-- Month grid -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-3 sm:p-4 shadow-xl shadow-black/20">
      <div class="grid grid-cols-7 text-center text-xs text-slate-500 mb-1">
        <% ["Su","Mo","Tu","We","Th","Fr","Sa"].forEach(function(d){ %><div class="py-1"><%= d %></div><% }); %>
      </div>
      <div class="grid grid-cols-7 gap-1">
        <% weeks.forEach(function(week){ week.forEach(function(cell){
             const isToday = cell.gregDate === today;
             const tag = cell.events.length ? "button" : "div";
             const cls = "day-cell relative rounded-xl p-1.5 sm:p-2 text-center min-h-[3.6rem] sm:min-h-[4.2rem] " +
               (cell.inMonth ? "" : "opacity-40 ") +
               (cell.events.length ? "has-events cursor-pointer hover:bg-slate-800/60 " : "") +
               (isToday ? "ring-2 ring-emerald-400 " : "");
        %>
        <<%= tag %> <% if (cell.events.length) { %>type="button" data-day="<%= cell.gregDate %>" aria-expanded="false" aria-controls="panel-<%= cell.gregDate %>"<% } %>
             class="<%= cls %>">
          <span class="block text-sm font-semibold <%= isToday ? 'text-emerald-300' : 'text-slate-200' %>"><%= Number(cell.gregDate.slice(8)) %></span>
          <span class="block text-[10px] leading-tight text-slate-400"><%= cell.hijriShort %></span>
          <% if (cell.events.length) { %>
          <span class="flex justify-center gap-1 mt-1">
            <% cell.events.slice(0, 3).forEach(function(ev){ %><span class="dot dot-<%= ev.type %>" title="<%= ev.name %>"></span><% }); %>
          </span>
          <% } %>
        </<%= tag %>>
        <% }); }); %>
      </div>
      <% if (!eventDays) { %>
      <p class="text-center text-slate-500 text-sm py-3">No marked events this month.</p>
      <% } %>
      <% if (hasCalculated) { %>
      <p class="text-center text-slate-500 text-[11px] mt-2">Some dates are calculated (civil calendar) rather than from the regional source — they can differ from a local sighting by a day or two.</p>
      <% } %>
    </div>

    <!-- Day detail panels (revealed on tap; all present for print/no-JS fallback via <noscript> below) -->
    <div id="panels" class="mt-4 space-y-3">
      <% weeks.forEach(function(week){ week.forEach(function(cell){ if (!cell.inMonth || !cell.events.length) return; %>
      <div id="panel-<%= cell.gregDate %>" hidden class="bg-slate-900/60 border border-slate-800 rounded-2xl p-4">
        <p class="text-emerald-300 font-bold">
          <%= monthLabel.split(" ")[0] %> <%= Number(cell.gregDate.slice(8)) %> · 🌙 <%= cell.hijriDay %> <%= cell.hijriMonthName %> <%= cell.hijriYear %> AH
        </p>
        <% cell.events.forEach(function(ev){ %>
        <div class="mt-3">
          <p class="text-white font-semibold"><span class="dot dot-<%= ev.type %> mr-2"></span><%= ev.name %></p>
          <p class="text-slate-400 text-sm mt-1"><%= ev.description %></p>
          <p class="text-slate-500 text-xs mt-1">
            Observed by: <%= ev.traditions.length === 2 ? "Sunni and Shia Muslims, in different ways" : (ev.traditions[0] === "sunni" ? "Sunni Muslims" : "Shia Muslims") %> ·
            begins the evening before, at Maghrib
            <% if (ev.disputed) { %> · <em>dates vary: <%= ev.disputed %></em><% } %>
          </p>
        </div>
        <% }); %>
      </div>
      <% }); }); %>
    </div>

    <p class="text-slate-500 text-xs mt-6 text-center">
      For worship (Ramaḍān, ʿĪd, ʿArafah), your local moon sighting or trusted community calendar always takes precedence over any app.
    </p>
    <div class="mt-6 text-center">
      <a href="/dashboard" class="text-slate-400 hover:text-emerald-400 transition-colors">&larr; Back to dashboard</a>
    </div>
  </div>

  <script>
  (function () {
    "use strict";
    var base = "/hijri?m=<%= monthParam %>";
    var tradition = "<%= tradition %>";
    var adjust = "<%= dayAdjust %>";

    // Day detail: tap a marked day to open/close its panel.
    var openId = null;
    Array.prototype.forEach.call(document.querySelectorAll("[data-day]"), function (btn) {
      btn.addEventListener("click", function () {
        var panel = document.getElementById("panel-" + btn.getAttribute("data-day"));
        if (!panel) return;
        if (openId && openId !== panel.id) {
          var prev = document.getElementById(openId);
          if (prev) prev.hidden = true;
          var prevBtn = document.querySelector('[data-day="' + openId.replace("panel-", "") + '"]');
          if (prevBtn) prevBtn.setAttribute("aria-expanded", "false");
        }
        panel.hidden = !panel.hidden;
        btn.setAttribute("aria-expanded", panel.hidden ? "false" : "true");
        openId = panel.hidden ? null : panel.id;
        if (!panel.hidden) panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    });

    // Filter / adjustment: save to prefs, then reload with the new view.
    function reload(tr, adj) {
      window.location.href = base + "&tradition=" + tr + "&adjust=" + adj;
    }
    function savePrefs(tr, adj) {
      fetch("/hijri/prefs", {
        method: "POST", headers: { "Content-Type": "application/json" },
        credentials: "same-origin", body: JSON.stringify({ tradition: tr, dayAdjust: Number(adj) }),
      }).catch(function () { /* view still works via query override */ });
    }
    Array.prototype.forEach.call(document.querySelectorAll(".trad-btn"), function (b) {
      b.addEventListener("click", function () {
        var tr = b.getAttribute("data-tradition");
        if (tr === tradition) return;
        savePrefs(tr, adjust); reload(tr, adjust);
      });
    });
    Array.prototype.forEach.call(document.querySelectorAll(".adj-btn"), function (b) {
      b.addEventListener("click", function () {
        var adj = b.getAttribute("data-adjust");
        if (String(adj) === String(adjust)) return;
        savePrefs(tradition, adj); reload(tradition, adj);
      });
    });
  })();
  </script>
</body>
</html>
