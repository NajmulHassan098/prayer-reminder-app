<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= member.name %> — <%= group.name %> Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/theme.js"></script>
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { isAdmin: true, user }) %>

  <!-- Main Content -->
  <main class="pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Back Navigation -->
    <div class="mb-6">
      <a href="/admin" class="inline-flex items-center gap-2 text-slate-400 hover:text-emerald-400 font-medium transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to <%= group.name %>
      </a>
    </div>

    <!-- Member Profile Card -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-2xl flex items-center justify-center text-slate-950 text-2xl font-bold shadow-lg shadow-emerald-500/20">
            <%= member.name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-white mb-1"><%= member.name %></h1>
            <p class="text-slate-400 mb-1"><%= member.email %></p>
            <p class="text-slate-500 text-sm"><%= member.city %>, <%= member.country %></p>
          </div>
        </div>
        <form method="POST" action="/group/remove-member/<%= member.id %>" onsubmit="return confirm('Remove this member from the group?');">
          <button type="submit" class="bg-red-500/90 hover:bg-red-500 text-white px-5 py-2.5 rounded-xl font-semibold transition-all shadow-lg shadow-red-500/20 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Remove from group
          </button>
        </form>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-emerald-500/10 ring-1 ring-inset ring-emerald-500/30 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-slate-400 text-sm font-medium">Completed</span>
        </div>
        <p class="text-3xl font-bold text-white"><%= totals.done || 0 %></p>
      </div>

      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-red-500/10 ring-1 ring-inset ring-red-500/30 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <span class="text-slate-400 text-sm font-medium">Missed</span>
        </div>
        <p class="text-3xl font-bold text-white"><%= totals.missed || 0 %></p>
      </div>

      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-amber-500/10 ring-1 ring-inset ring-amber-500/30 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="text-slate-400 text-sm font-medium">Pending</span>
        </div>
        <p class="text-3xl font-bold text-white"><%= totals.pending || 0 %></p>
      </div>

      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-indigo-500/10 ring-1 ring-inset ring-indigo-500/30 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <span class="text-slate-400 text-sm font-medium">Completion</span>
        </div>
        <p class="text-3xl font-bold text-white"><%= pct === null ? '—' : pct + '%' %></p>
      </div>
    </div>

    <!-- History Table -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
      <h2 class="text-xl font-bold text-white mb-4">Full history</h2>
      <% if (history.length === 0) { %>
        <div class="text-center py-10">
          <div class="w-14 h-14 bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="text-slate-400">No prayer responses logged yet for this member.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto rounded-2xl border border-slate-800">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-800/60">
                <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Date</th>
                <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Prayer</th>
                <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Status</th>
                <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Responded at</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% history.forEach(function(r) { %>
                <tr class="transition-colors hover:bg-slate-800/40">
                  <td class="px-5 py-4 text-slate-300 font-mono"><%= r.date %></td>
                  <td class="px-5 py-4 text-slate-200 font-medium"><%= r.prayer_name %></td>
                  <td class="px-5 py-4">
                    <% if (r.status === 'done') { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-300 ring-1 ring-inset ring-emerald-500/30"><span class="mr-1.5">✓</span> Done</span>
                    <% } else if (r.status === 'missed') { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-300 ring-1 ring-inset ring-red-500/30"><span class="mr-1.5">✗</span> Missed</span>
                    <% } else if (r.status === 'pending') { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-300 ring-1 ring-inset ring-amber-500/30"><span class="mr-1.5">○</span> Pending</span>
                    <% } else { %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-500/10 text-slate-400 ring-1 ring-inset ring-slate-500/30"><span class="mr-1.5">○</span> <%= r.status %></span>
                    <% } %>
                  </td>
                  <td class="px-5 py-4 text-sm text-slate-400"><%= r.responded_at || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
