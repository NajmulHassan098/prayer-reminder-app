<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Qibla — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">
  <script src="/theme.js"></script>
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { user, isAdmin: false }) %>
  <div class="container mx-auto px-4 pt-24 pb-12 max-w-2xl">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white mb-1">Qibla direction</h1>
      <p class="text-slate-400">The direction of the Kaaba in Makkah, calculated from your saved location<% if (user.city) { %> — <span class="text-slate-300"><%= user.city %>, <%= user.country %></span><% } %>.</p>
    </div>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/30 text-red-300 rounded-2xl p-4 mb-6">
        <%= error %>
      </div>
      <div class="text-center">
        <a href="/profile" class="text-emerald-400 hover:text-emerald-300 font-medium">&rarr; Update your location</a>
      </div>
    <% } else { %>

      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
        <div class="relative w-[260px] h-[260px] mx-auto select-none">
          <svg id="compass-svg" viewBox="0 0 200 200" class="w-full h-full" data-dir="<%= qibla.direction %>" style="transform: rotate(0deg); transition: transform 0.2s ease-out">
            <circle cx="100" cy="100" r="95" fill="none" stroke="rgba(148,163,184,0.25)" stroke-width="2"/>
            <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(148,163,184,0.12)" stroke-width="1"/>
            <!-- cardinal points -->
            <text x="100" y="20" text-anchor="middle" font-size="14" font-weight="700" fill="#f87171">N</text>
            <text x="184" y="105" text-anchor="middle" font-size="13" fill="#94a3b8">E</text>
            <text x="100" y="192" text-anchor="middle" font-size="13" fill="#94a3b8">S</text>
            <text x="16" y="105" text-anchor="middle" font-size="13" fill="#94a3b8">W</text>
            <!-- Qibla needle, rotated to the bearing (0deg = North / up) -->
            <g transform="rotate(<%= qibla.direction %> 100 100)">
              <line x1="100" y1="100" x2="100" y2="26" stroke="#34d399" stroke-width="4" stroke-linecap="round"/>
              <circle cx="100" cy="24" r="11" fill="#34d399"/>
              <text x="100" y="29" text-anchor="middle" font-size="12">&#12295;</text>
            </g>
            <circle cx="100" cy="100" r="6" fill="#0f172a" stroke="#34d399" stroke-width="2"/>
          </svg>
          <div class="absolute inset-0 flex items-end justify-center pointer-events-none pb-2">
            <div class="bg-slate-950/70 rounded-xl px-3 py-1 text-center">
              <span class="text-2xl font-bold text-emerald-400"><%= Math.round(qibla.direction) %>&deg;</span>
              <span class="text-xs text-slate-400 block">from true North</span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-6 text-center">
          <div class="bg-slate-800/50 rounded-xl p-3">
            <p class="text-slate-400 text-xs uppercase tracking-wider">Distance to Makkah</p>
            <p class="text-white text-lg font-bold mt-1"><%= qibla.distanceKm.toLocaleString() %> km</p>
          </div>
          <div class="bg-slate-800/50 rounded-xl p-3">
            <p class="text-slate-400 text-xs uppercase tracking-wider">Coordinates</p>
            <p class="text-white text-lg font-bold mt-1"><%= qibla.lat.toFixed(2) %>, <%= qibla.lng.toFixed(2) %></p>
          </div>
        </div>

        <div id="compass-live" class="hidden mt-6 text-center">
          <p class="text-sm text-slate-400">Heading: <span id="compass-heading" class="text-white font-mono">—</span></p>
          <p id="compass-align" class="text-sm font-semibold mt-1 text-slate-400">Turn until the green marker is at the top.</p>
        </div>

        <button id="compass-toggle"
                class="w-full mt-6 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold rounded-xl shadow-lg shadow-emerald-500/20 transition-all">
          Enable live compass
        </button>
        <p id="compass-note" class="text-slate-500 text-xs mt-3 text-center">
          On a phone, tap above and point your device — the dial will turn so the green marker always points to the Qibla.
          On a desktop, face North then turn clockwise by <%= Math.round(qibla.direction) %>&deg;.
        </p>
      </div>

    <% } %>

    <div class="mt-6 text-center">
      <a href="/dashboard" class="text-slate-400 hover:text-emerald-400 transition-colors">&larr; Back to dashboard</a>
    </div>

  </div>

  <% if (!error) { %>
  <script>
    (function () {
      var svg = document.getElementById('compass-svg');
      var btn = document.getElementById('compass-toggle');
      if (!svg || !btn) return;
      var dir = parseFloat(svg.getAttribute('data-dir')) || 0;
      var live = document.getElementById('compass-live');
      var headingEl = document.getElementById('compass-heading');
      var alignEl = document.getElementById('compass-align');
      var note = document.getElementById('compass-note');
      var watching = false;

      function shortestDelta(a, b) {
        return ((a - b + 540) % 360) - 180;
      }

      function onHeading(e) {
        var heading = null;
        if (typeof e.webkitCompassHeading === 'number') {
          heading = e.webkitCompassHeading; // degrees clockwise from true North (iOS)
        } else if (typeof e.alpha === 'number') {
          heading = 360 - e.alpha; // best-effort fallback (not true-North referenced)
        }
        if (heading == null) return;
        svg.style.transform = 'rotate(' + (-heading) + 'deg)';
        if (headingEl) headingEl.textContent = Math.round(heading) + '°';
        var off = Math.abs(shortestDelta(dir, heading));
        if (alignEl) {
          if (off <= 5) {
            alignEl.textContent = '✓ You are facing the Qibla';
            alignEl.className = 'text-sm font-semibold mt-1 text-emerald-400';
          } else {
            var cw = shortestDelta(dir - heading, 0) > 0;
            alignEl.textContent = 'Turn ' + (cw ? 'right' : 'left') + ' about ' + Math.round(off) + '°';
            alignEl.className = 'text-sm font-semibold mt-1 text-amber-300';
          }
        }
      }

      async function start() {
        try {
          // iOS 13+ requires a user-gesture permission request for motion sensors.
          if (typeof DeviceOrientationEvent !== 'undefined' &&
              typeof DeviceOrientationEvent.requestPermission === 'function') {
            var perm = await DeviceOrientationEvent.requestPermission();
            if (perm !== 'granted') { note.textContent = 'Compass permission was denied.'; return; }
          }
          if (typeof DeviceOrientationEvent !== 'undefined' &&
              typeof DeviceOrientationEvent.requestPermission !== 'function' &&
              typeof window.ondeviceorientation === 'undefined') {
            note.textContent = 'This browser does not expose a compass. Use the static reading above.';
            return;
          }
          window.addEventListener('deviceorientationabsolute', onHeading, true);
          window.addEventListener('deviceorientation', onHeading, true);
          watching = true;
          if (live) live.classList.remove('hidden');
          btn.textContent = 'Disable live compass';
          btn.className = 'w-full mt-6 py-3.5 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded-xl transition-all';
        } catch (err) {
          note.textContent = 'Could not start the compass: ' + err.message;
        }
      }

      function stop() {
        window.removeEventListener('deviceorientationabsolute', onHeading, true);
        window.removeEventListener('deviceorientation', onHeading, true);
        watching = false;
        svg.style.transform = 'rotate(0deg)';
        if (live) live.classList.add('hidden');
        btn.textContent = 'Enable live compass';
        btn.className = 'w-full mt-6 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold rounded-xl shadow-lg shadow-emerald-500/20 transition-all';
      }

      btn.addEventListener('click', function () { watching ? stop() : start(); });
    })();
  </script>
  <% } %>
</body>
</html>
