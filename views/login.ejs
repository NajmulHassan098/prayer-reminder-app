<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Log In — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#6ee7b7',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
            },
            dark: {
              bg: '#0f172a',
              card: '#1e293b',
              input: '#334155',
            }
          },
        },
      },
    }
  </script>
      <!-- Standalone auth page: stays dark by design (no theme toggle here). -->
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased flex items-center justify-center p-4" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <div class="w-full max-w-md">
    <!-- Back to Home -->
    <div class="mb-6 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-white/70 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Login Card -->
    <div class="bg-dark-card rounded-2xl p-8 shadow-2xl border border-slate-800">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-primary-500/30">
          <span class="text-3xl">🕌</span>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">Log in to your account</h1>
        <p class="text-white/60 text-sm">Welcome back to Prayer Reminder</p>
      </div>

      <% if (error) { %>
        <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl mb-6">
          <%= error %>
        </div>
      <% } %>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="bg-primary-500/10 border border-primary-500/20 text-primary-300 p-4 rounded-xl mb-6">
          <%= message %>
        </div>
      <% } %>

      <form method="POST" action="/login" class="space-y-6">
        <!-- Email Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">Email</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
              </svg>
            </div>
            <input type="email" name="email" required placeholder="example@gmail.com"
                   class="w-full pl-12 pr-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
          </div>
        </div>

        <!-- Password Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">Password</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <input type="password" name="password" required placeholder="••••••••"
                   class="w-full pl-12 pr-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
          </div>
        </div>

        <!-- Remember & Forgot -->
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-white/70 text-sm cursor-pointer">
            <input type="checkbox" class="w-4 h-4 rounded border-white/20 bg-dark-input text-primary-500 focus:ring-primary-500">
            Remember me
          </label>
          <a href="/forgot-password" class="text-primary-400 hover:text-primary-300 text-sm">Forgot password?</a>
        </div>

        <!-- Submit Button -->
        <button type="submit" 
                class="w-full py-3.5 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-primary-500/50 transition-all transform hover:scale-[1.02]">
          Sign In
        </button>
      </form>

      <!-- Divider -->
      <div class="relative my-8">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-white/10"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-dark-card text-white/40">Or continue with</span>
        </div>
      </div>

      <!-- Social Login Buttons -->
      <div class="space-y-3">
        <button class="w-full py-3 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-medium rounded-xl flex items-center justify-center gap-3 transition-all">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        </button>
        
        <button class="w-full py-3 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-medium rounded-xl flex items-center justify-center gap-3 transition-all">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31 1.04-2.52 1.04-4.01.03-1.49-1.02-2.9-2.48-4.52-2.48-3.13 0-5.27 2.37-5.27 6.17 0 3.73 2.72 7.88 5.12 7.88 2.4 0 3.95-1.72 5.07-1.72 1.11 0 1.92.81 3.01 1.72 1.11.9 2.39.77 3.41.77.97 0 2.45-.63 4.01-2.55zm-2.98-16.17c1.08-1.3 1.91-3.12 1.68-4.94-1.64.07-3.63.69-4.75 1.96-1.05 1.18-1.87 3.07-1.64 4.85 1.83.14 3.71-.57 4.71-1.87z"/>
          </svg>
          Continue with Apple
        </button>
      </div>

      <!-- Sign Up Link -->
      <p class="text-center text-white/60 text-sm mt-8">
        Don't have an account? 
        <a href="/register" class="text-primary-400 hover:text-primary-300 font-medium">Sign up</a>
      </p>
    </div>
  </div>
</body>
</html>
