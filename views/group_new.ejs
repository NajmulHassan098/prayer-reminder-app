<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Create Group — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/theme.js"></script>
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased flex flex-col" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { isAdmin: false, user: (typeof user !== 'undefined' && user) ? user : null }) %>

  <main class="flex-1 flex items-center justify-center px-4 pt-24 pb-12">
    <div class="w-full max-w-lg">
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-8 shadow-xl shadow-black/20">
        <div class="text-center mb-8">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-emerald-500/30">
            <span class="text-3xl">👥</span>
          </div>
          <h1 class="text-2xl font-bold text-white mb-2">Create a group</h1>
          <p class="text-slate-400 text-sm">You'll become this group's admin. Groups are capped at 30 members and the join code is permanent.</p>
        </div>

        <% if (error) { %>
          <div class="bg-red-500/10 border border-red-500/30 text-red-300 p-4 rounded-xl mb-6 text-sm"><%= error %></div>
        <% } %>

        <form method="POST" action="/group/new" class="space-y-5">
          <div>
            <label class="block text-slate-300 text-sm font-medium mb-2">Group name</label>
            <input type="text" name="name" required placeholder="e.g. Family Prayer Circle"
                   class="w-full px-4 py-3 bg-slate-800/60 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all" />
          </div>
          <button type="submit"
                  class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold rounded-xl shadow-lg shadow-emerald-500/20 transition-all transform hover:scale-[1.02]">
            Create Group
          </button>
        </form>

        <p class="text-center text-slate-400 text-sm mt-6">
          Already have a join code?
          <a href="/group/join" class="text-emerald-400 hover:text-emerald-300 font-medium">Join an existing group</a>
        </p>
      </div>
    </div>
  </main>
</body>
</html>
