<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Weekly Prayer Table — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { isAdmin, user }) %>

  <div class="container mx-auto px-4 pt-24 pb-12 max-w-5xl">
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
      <div class="flex items-center justify-between mb-1">
        <h1 class="text-2xl font-bold text-white">Weekly prayer table</h1>
        <span class="text-xs text-slate-500 font-medium uppercase tracking-wider"><%= today %></span>
      </div>

      <% if (!group) { %>
        <p class="text-slate-400 mt-3 mb-2">You're not in a group yet, so there's no shared weekly table to show.</p>
        <a href="/group/new" class="inline-block mt-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 px-5 py-2.5 rounded-xl font-semibold transition-colors shadow-lg shadow-emerald-500/20">Create a group</a>
      <% } else { %>
        <p class="text-slate-400 text-sm mt-3 mb-5">
          Prayers completed each day over the last 7 days (out of 5) for everyone in
          <strong class="text-slate-200"><%= group.name %></strong>
          <% if (weekDates.length) { %>
            &middot; <span class="text-slate-500"><%= weekDates[0].date %> → <%= weekDates[weekDates.length - 1].date %></span>
          <% } %>
        </p>

        <!-- Live member search -->
        <div id="weekly-scope">
          <div class="member-search mb-5 text-slate-200 max-w-xs">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" id="member-search" placeholder="Search a member by name…" autocomplete="off" />
          </div>

          <% if (weekly.length === 0) { %>
            <p class="text-slate-500 text-sm">No weekly data yet.</p>
          <% } else { %>
            <div class="overflow-x-auto rounded-2xl border border-slate-800">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-slate-800/60">
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">Member</th>
                    <% weekDates.forEach(function(d){ %>
                      <th class="px-1 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-400">
                        <div><%= d.label %></div>
                        <div class="text-slate-500 font-normal"><%= d.day %></div>
                      </th>
                    <% }); %>
                    <th class="px-3 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-400">Week</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                  <% weekly.forEach(function(row){ %>
                    <% var isYou = row.member.id === user.id; %>
                    <tr data-member="<%= row.member.name.toLowerCase() %>" class="transition-colors hover:bg-slate-800/40 <%= isYou ? 'bg-emerald-500/5' : '' %>">
                      <td class="px-4 py-3">
                        <span class="font-semibold text-white"><%= row.member.name %></span>
                        <% if (isYou) { %><span class="ml-2 text-[10px] font-bold uppercase tracking-wider text-emerald-300 bg-emerald-500/10 ring-1 ring-inset ring-emerald-500/30 px-2 py-0.5 rounded-full">You</span><% } %>
                      </td>
                      <% row.days.forEach(function(day){ %>
                        <% var done = day.done; var cell = done >= 5 ? 'bg-emerald-500 text-slate-950' : done >= 3 ? 'bg-emerald-500/40 text-emerald-50' : done >= 1 ? 'bg-emerald-500/15 text-emerald-200' : 'bg-slate-700/40 text-slate-500'; %>
                        <td class="px-1 py-3 text-center">
                          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-xs font-bold <%= cell %>" title="<%= day.date %>: <%= done %>/5 prayed"><%= done %></span>
                        </td>
                      <% }); %>
                      <td class="px-3 py-3 text-center">
                        <span class="font-bold text-emerald-400"><%= row.totalDone %></span><span class="text-slate-500 text-xs">/35</span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Legend -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-5 text-xs text-slate-400">
              <span class="inline-flex items-center"><span class="w-4 h-4 rounded bg-emerald-500 mr-1.5"></span>5/5</span>
              <span class="inline-flex items-center"><span class="w-4 h-4 rounded bg-emerald-500/40 mr-1.5"></span>3–4</span>
              <span class="inline-flex items-center"><span class="w-4 h-4 rounded bg-emerald-500/15 mr-1.5"></span>1–2</span>
              <span class="inline-flex items-center"><span class="w-4 h-4 rounded bg-slate-700/40 mr-1.5"></span>0</span>
            </div>
          <% } %>
        </div>
      <% } %>

      <div class="mt-6">
        <a href="/dashboard" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium">&larr; Back to dashboard</a>
      </div>
    </div>
  </div>

  <%- include('components/footer', { isAdmin }) %>

  <script>
    // Live client-side member search for the weekly table.
    (function () {
      var input = document.getElementById('member-search');
      var scope = document.getElementById('weekly-scope');
      if (!input || !scope) return;
      var items = Array.prototype.slice.call(scope.querySelectorAll('[data-member]'));
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        items.forEach(function (el) {
          var match = !q || el.getAttribute('data-member').indexOf(q) !== -1;
          el.style.display = match ? '' : 'none';
        });
      });
    })();
  </script>
</body>
</html>
