<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign Up — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f0fdf4',
              100: '#dcfce7',
              200: '#bbf7d0',
              300: '#6ee7b7',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
            },
            dark: {
              bg: '#0f172a',
              card: '#1e293b',
              input: '#334155',
            }
          },
        },
      },
    }
  </script>
      <!-- Standalone auth page: stays dark by design (no theme toggle here). -->
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased flex items-center justify-center p-4" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <div class="w-full max-w-md">
    <!-- Back to Home -->
    <div class="mb-6 text-center">
      <a href="/" class="inline-flex items-center gap-2 text-white/70 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Signup Card -->
    <div class="bg-dark-card rounded-2xl p-8 shadow-2xl border border-slate-800">
      <!-- Logo -->
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-primary-500/30">
          <span class="text-3xl">🕌</span>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">Create your account</h1>
        <p class="text-white/60 text-sm">Join Prayer Reminder today</p>
      </div>

      <% if (typeof invitation !== 'undefined' && invitation) { %>
        <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 p-4 rounded-xl mb-6">
          <p class="text-sm">
            <strong><%= invitation.inviter_name %></strong> has invited you to join <strong><%= invitation.group_name %></strong>
          </p>
        </div>
      <% } %>
      
      <% if (error) { %>
        <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl mb-6">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/register" class="space-y-5">
        <!-- Name Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">Full Name</label>
          <input type="text" name="name" required placeholder="John Doe"
                 class="w-full px-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
        </div>

        <!-- Email Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">Email</label>
          <input type="email" name="email" required placeholder="john@example.com"
                 class="w-full px-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
        </div>

        <!-- Password Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">Password</label>
          <input type="password" name="password" required placeholder="••••••••"
                 class="w-full px-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
        </div>

        <!-- City Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">City (for prayer times)</label>
          <input type="text" name="city" required placeholder="e.g. Lahore"
                 class="w-full px-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
        </div>

        <!-- Country Input -->
        <div>
          <label class="block text-white/80 text-sm font-medium mb-2">Country</label>
          <input type="text" name="country" required placeholder="e.g. Pakistan"
                 class="w-full px-4 py-3 bg-dark-input border border-white/10 rounded-xl text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
        </div>
        
        <% if (typeof invitation !== 'undefined' && invitation) { %>
          <input type="hidden" name="invite_token" value="<%= invitation.token %>" />
        <% } else { %>
          <input type="hidden" name="invite_token" value="" />
        <% } %>
        
        <!-- Submit Button -->
        <button type="submit" 
                class="w-full py-3.5 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-primary-500/50 transition-all transform hover:scale-[1.02]">
          Create Account
        </button>
      </form>

      <!-- Login Link -->
      <p class="text-center text-white/60 text-sm mt-8">
        Already have an account? 
        <a href="/login" class="text-primary-400 hover:text-primary-300 font-medium">Log in</a>
      </p>
    </div>
  </div>
</body>
</html>