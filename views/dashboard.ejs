<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          animation: {
            'pulse-slow': 'pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
          },
        },
      },
    }
  </script>
  <script src="/theme.js"></script>
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { isAdmin, user, showSearch: true }) %>
  <div class="container mx-auto px-4 pt-24 pb-12 max-w-4xl">

    <% if (isJummah) { %>
    <!-- Jumu'ah banner (Fridays only) -->
    <div class="bg-gradient-to-br from-indigo-600/25 to-emerald-600/20 backdrop-blur border border-emerald-500/30 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl">&#128332;</span>
        <div>
          <p class="text-xs font-bold tracking-wider uppercase text-emerald-300">Jumu'ah Mubarak</p>
          <h2 class="text-xl font-bold text-white">Today is Friday</h2>
        </div>
      </div>
      <p class="text-right text-xl text-slate-100 mb-4 leading-relaxed" style="font-family: 'Amiri', 'Noto Naskh Arabic', serif; direction: rtl;">
        إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ
      </p>
      <ul class="space-y-2 text-slate-300 text-sm">
        <li class="flex items-start gap-2"><span class="text-emerald-400 mt-0.5">&#10003;</span><span>Read <span class="text-white font-semibold">Surah Al-Kahf</span> — a light between the two Fridays.</span></li>
        <li class="flex items-start gap-2"><span class="text-emerald-400 mt-0.5">&#10003;</span><span>Send abundant <span class="text-white font-semibold">salawat</span> upon the Prophet &#65018;.</span></li>
        <li class="flex items-start gap-2"><span class="text-emerald-400 mt-0.5">&#10003;</span><span>Make earnest <span class="text-white font-semibold">du'a</span> — there is an hour of accepted supplication today.</span></li>
      </ul>
    </div>
    <% } %>

    <!-- Reminder Banner -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 border-l-4 border-l-emerald-500 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
      <span class="inline-block text-xs font-bold tracking-wider uppercase text-emerald-300 bg-emerald-500/10 ring-1 ring-inset ring-emerald-500/30 px-3 py-1 rounded-full mb-3"><%= reminder.type %></span>
      <% if (reminder.arabic) { %>
        <p class="text-right text-2xl text-slate-100 mb-3 leading-relaxed" style="font-family: 'Amiri', 'Noto Naskh Arabic', serif; direction: rtl;">
          <%= reminder.arabic %>
        </p>
      <% } %>
      <p class="text-slate-300 italic text-lg">&ldquo;<%= reminder.text %>&rdquo;</p>
      <p class="text-slate-500 text-sm mt-2">— <%= reminder.reference %></p>
    </div>

    <!-- Welcome Card -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
      <h1 class="text-2xl font-bold text-white mb-2">Assalamu Alaikum, <%= user.name %> 👋</h1>
      <p class="text-slate-400"><%= user.city %>, <%= user.country %></p>
    </div>

    <!-- Group Status -->
    <% if (!group) { %>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
        <h2 class="text-xl font-bold text-white mb-3">You're not in a group yet</h2>
        <p class="text-slate-400 mb-4">Create your own group to start tracking prayers with friends and family, then invite members via email.</p>
        <div class="flex gap-3">
          <a href="/group/new" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 px-6 py-3 rounded-xl font-semibold transition-colors shadow-lg shadow-emerald-500/20">Create a group</a>
        </div>
      </div>
    <% } else { %>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-white"><%= group.name %></h2>
          <% if (isAdmin) { %>
            <span class="bg-amber-500/10 text-amber-300 ring-1 ring-inset ring-amber-500/30 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Admin</span>
          <% } %>
        </div>
        <p class="text-slate-400"><%= memberCount %>/30 members</p>
      </div>
    <% } %>

    <!-- Today's Prayer Times -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-white">Today's prayer times</h2>
          <a href="/times" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium">Live countdown &amp; Tahajjud &rarr;</a>
        </div>
        <!-- Progress Indicator -->
        <div class="flex items-center gap-3">
          <div class="text-right">
            <p class="text-sm text-slate-400">Daily Progress</p>
            <p class="text-lg font-bold text-emerald-400"><%= completedCount %>/5</p>
          </div>
          <div class="w-16 h-16 relative">
            <svg class="w-16 h-16 transform -rotate-90">
              <circle cx="32" cy="32" r="28" stroke="#1e293b" stroke-width="4" fill="none"/>
              <circle cx="32" cy="32" r="28" stroke="#10b981" stroke-width="4" fill="none"
                      stroke-dasharray="<%= (completedCount / 5) * 175.9 %> 175.9"
                      stroke-linecap="round"/>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-sm font-bold text-emerald-400"><%= Math.round((completedCount / 5) * 100) %>%</span>
            </div>
          </div>
        </div>
      </div>

      <% if (apiError) { %>
        <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-4 text-red-300"><%= apiError %></div>
      <% } else if (!todayTimes) { %>
        <p class="text-slate-400">Times will appear once your location is set.</p>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          <% PRAYERS.forEach(function(p) { %>
            <% var st = statusMap[p] || 'none'; %>
            <% var isActive = st === 'done'; %>
            <% var isMissed = st === 'missed'; %>
            <div class="bg-slate-800/50 rounded-2xl border border-slate-700/60 p-4 text-center transition-all hover:border-emerald-500/40 hover:bg-slate-800/80">
              <div class="font-bold text-emerald-400 text-sm mb-1"><%= p %></div>
              <div class="text-2xl font-bold text-white mb-2"><%= todayTimes[p.toLowerCase()] %></div>

              <!-- Status Badge -->
              <div class="mb-3">
                <% if (st === 'done') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-300 ring-1 ring-inset ring-emerald-500/30">
                    <span class="mr-1">✓</span> Done
                  </span>
                <% } else if (st === 'missed') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-300 ring-1 ring-inset ring-red-500/30">
                    <span class="mr-1">✗</span> Missed<%= (typeof sourceMap !== 'undefined' && sourceMap[p] === 'auto') ? ' · auto' : '' %>
                  </span>
                <% } else if (st === 'pending') { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-300 ring-1 ring-inset ring-amber-500/30">
                    <span class="mr-1">○</span> Pending
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-500/10 text-slate-400 ring-1 ring-inset ring-slate-500/30">
                    <span class="mr-1">○</span> Not yet
                  </span>
                <% } %>
              </div>

              <!-- Interactive Buttons -->
              <div class="flex gap-2 justify-center">
                <form method="POST" action="/prayer/mark" class="flex-1 mark-form">
                  <input type="hidden" name="prayer_name" value="<%= p %>" />
                  <input type="hidden" name="date" value="<%= today %>" />
                  <input type="hidden" name="status" value="done" />
                  <button type="submit" aria-pressed="<%= isActive ? 'true' : 'false' %>" data-mark="done"
                          class="mark-btn w-full min-h-[44px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-150 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 select-none
                                 <%= isActive ? 'bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/30 ring-1 ring-inset ring-emerald-400' : 'bg-slate-700/50 text-emerald-300 ring-1 ring-inset ring-emerald-500/30 hover:bg-emerald-500/20 hover:text-emerald-200' %>">
                    ✅ Prayed
                  </button>
                </form>
                <form method="POST" action="/prayer/mark" class="flex-1 mark-form">
                  <input type="hidden" name="prayer_name" value="<%= p %>" />
                  <input type="hidden" name="date" value="<%= today %>" />
                  <input type="hidden" name="status" value="missed" />
                  <button type="submit" aria-pressed="<%= isMissed ? 'true' : 'false' %>" data-mark="missed"
                          class="mark-btn w-full min-h-[44px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all duration-150 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400 select-none
                                 <%= isMissed ? 'bg-red-500 text-white shadow-lg shadow-red-500/30 ring-1 ring-inset ring-red-400' : 'bg-slate-700/50 text-red-300 ring-1 ring-inset ring-red-500/30 hover:bg-red-500/20 hover:text-red-200' %>">
                    ❌ Not Prayed
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>
        <p class="text-slate-500 text-sm mt-4 text-center">Times auto-refresh daily and are calculated for <%= user.city %>, <%= user.country %> using the standard method for your country. <a href="/profile" class="text-emerald-400 hover:text-emerald-300 underline">Edit your location</a></p>
      <% } %>
    </div>

    <!-- Group Activity entry point (the full log lives on its own page) -->
    <% if (group) { %>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 mb-6 shadow-xl shadow-black/20 flex items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold text-white">Group prayer log</h3>
          <p class="text-slate-400 text-sm mt-1">See what everyone in <span class="text-slate-300"><%= group.name %></span> has prayed, day by day.</p>
        </div>
        <a href="/group/activity" class="shrink-0 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-lg shadow-emerald-500/20">View &rarr;</a>
      </div>
    <% } %>

    <!-- Recent History -->
    <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
      <h2 class="text-xl font-bold text-white mb-4">Your recent history</h2>
      <% if (recentHistory.length === 0) { %>
        <div class="text-center py-10">
          <div class="w-14 h-14 bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-2xl">📖</span>
          </div>
          <p class="text-slate-400">No responses logged yet — check back after your first reminder email.</p>
        </div>
      <% } else { %>
        <div class="flex gap-3 overflow-x-auto pb-2 -mx-1 px-1 snap-x">
          <% recentHistory.forEach(function(r) { %>
            <div class="snap-start shrink-0 w-36 sm:w-40 bg-slate-800/40 border border-slate-700/60 rounded-xl p-4 flex flex-col gap-2.5">
              <span class="font-mono text-xs text-slate-400"><%= r.date %></span>
              <span class="text-slate-100 font-bold text-lg leading-none"><%= r.prayer_name %></span>
              <% if (r.status === 'done') { %>
                <span class="inline-flex items-center self-start px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-300 ring-1 ring-inset ring-emerald-500/30"><span class="mr-1.5">✓</span> Done</span>
              <% } else if (r.status === 'missed') { %>
                <span class="inline-flex items-center self-start px-3 py-1 rounded-full text-xs font-bold bg-red-500/10 text-red-300 ring-1 ring-inset ring-red-500/30"><span class="mr-1.5">✗</span> Missed</span>
              <% } else if (r.status === 'pending') { %>
                <span class="inline-flex items-center self-start px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-300 ring-1 ring-inset ring-amber-500/30"><span class="mr-1.5">○</span> Pending</span>
              <% } else { %>
                <span class="inline-flex items-center self-start px-3 py-1 rounded-full text-xs font-bold bg-slate-500/10 text-slate-400 ring-1 ring-inset ring-slate-500/30"><span class="mr-1.5">○</span> <%= r.status %></span>
              <% } %>
            </div>
          <% }); %>
        </div>
        <p class="text-slate-500 text-xs mt-3">Swipe or scroll sideways to see more &rarr;</p>
      <% } %>
    </div>

  </div>

  <%- include('components/footer', { isAdmin }) %>


  <script>
    // Live client-side member search (header + mobile boxes stay in sync).
    (function () {
      var scope = document.getElementById('group-activity');
      var inputs = Array.prototype.slice.call(document.querySelectorAll('.member-search input'));
      if (!scope || !inputs.length) return;
      var items = Array.prototype.slice.call(scope.querySelectorAll('[data-member]'));
      function run(value) {
        var q = value.trim().toLowerCase();
        items.forEach(function (el) {
          var match = !q || el.getAttribute('data-member').indexOf(q) !== -1;
          el.style.display = match ? '' : 'none';
        });
      }
      inputs.forEach(function (inp) {
        inp.addEventListener('input', function () {
          inputs.forEach(function (o) { if (o !== inp) o.value = inp.value; });
          run(inp.value);
        });
      });
    })();

    // Prayed / Not Prayed: immediate tap feedback. The form still submits
    // natively (reliable across devices), but on submit we lock both buttons
    // and show a "Saving…" state on the pressed one until the page reloads
    // with the updated status.
    (function () {
      var forms = Array.prototype.slice.call(document.querySelectorAll('form.mark-form'));
      if (!forms.length) return;
      var buttons = Array.prototype.slice.call(document.querySelectorAll('form.mark-form button.mark-btn'));
      forms.forEach(function (form) {
        form.addEventListener('submit', function () {
          var btn = form.querySelector('button.mark-btn');
          buttons.forEach(function (b) {
            b.disabled = true;
            if (b !== btn) b.classList.add('opacity-40');
          });
          if (btn) {
            btn.classList.add('opacity-90');
            btn.innerHTML = '<span class="inline-block animate-spin mr-1.5">&#9676;</span>Saving\u2026';
          }
        });
      });
    })();
  </script>
</body>
</html>
