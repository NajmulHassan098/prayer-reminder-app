<!-- Modern Navigation Component (supports day/night theme) -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-xl border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/30">
          <span class="text-white text-xl">🕌</span>
        </div>
        <a href="/dashboard" class="text-xl font-bold text-white hover:text-emerald-400 transition-colors">
          Prayer Reminder
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/dashboard" class="text-slate-300 hover:text-emerald-400 font-medium transition-colors">Dashboard</a>
        <a href="/times" class="text-slate-300 hover:text-emerald-400 font-medium transition-colors" title="Live countdown, today's schedule and Tahajjud">Today</a>
        <a href="/weekly" class="text-slate-300 hover:text-emerald-400 font-medium transition-colors flex items-center gap-2" title="Weekly prayer table for your group">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Weekly
        </a>
        <a href="/qibla" class="text-slate-300 hover:text-emerald-400 font-medium transition-colors flex items-center gap-2" title="Find the Qibla direction">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a10 10 0 100 20 10 10 0 000-20z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.5 8.5l-2 5-5 2 2-5 5-2z"/>
          </svg>
          Qibla
        </a>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" class="text-slate-300 hover:text-emerald-400 font-medium transition-colors flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Admin
          </a>
        <% } %>

        <% if (typeof showSearch !== 'undefined' && showSearch) { %>
        <!-- Top member search -->
        <div class="member-search text-slate-200 w-56">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" placeholder="Search a member…" autocomplete="off" />
        </div>
        <% } %>

        <div class="flex items-center gap-3">
          <!-- Day / Night toggle -->
          <button type="button" onclick="toggleTheme()" aria-label="Toggle day / night mode" title="Toggle day / night mode"
                  class="w-9 h-9 rounded-full flex items-center justify-center bg-slate-800/60 hover:bg-slate-700 text-slate-200 ring-1 ring-inset ring-slate-700 transition-colors">
            <!-- sun (shown in dark mode) -->
            <svg class="theme-icon-sun w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <!-- moon (shown in light mode) -->
            <svg class="theme-icon-moon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </button>

          <a href="/profile" class="flex items-center gap-2 text-slate-300 hover:text-emerald-400 font-medium transition-colors" title="Edit your name, city and country">
            <% if (typeof user !== 'undefined' && user && user.name) { %>
              <div class="w-8 h-8 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-full flex items-center justify-center text-white font-semibold text-sm shadow-lg shadow-emerald-500/20">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
            <% } else { %>
              <div class="w-8 h-8 bg-gradient-to-br from-emerald-400 to-teal-500 rounded-full flex items-center justify-center text-white font-semibold text-sm shadow-lg shadow-emerald-500/20">
                U
              </div>
            <% } %>
            <span class="hidden lg:inline">Profile</span>
          </a>
          <form method="POST" action="/logout">
            <button type="submit" class="text-slate-300 hover:text-red-400 font-medium transition-colors flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              Log out
            </button>
          </form>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button class="md:hidden p-2 rounded-lg hover:bg-slate-800 transition-colors" onclick="toggleMobileMenu()">
        <svg class="w-6 h-6 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-slate-900 border-t border-slate-800">
    <div class="px-4 py-3 space-y-2">
      <% if (typeof showSearch !== 'undefined' && showSearch) { %>
      <div class="member-search mb-1 text-slate-200">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" placeholder="Search a member by name…" autocomplete="off" />
      </div>
      <% } %>
      <a href="/dashboard" class="block px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors">
        Dashboard
      </a>
      <a href="/times" class="block px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors">
        Today (countdown &amp; Tahajjud)
      </a>
      <a href="/weekly" class="block px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors">
        Weekly prayer table
      </a>
      <a href="/qibla" class="block px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors">
        Qibla direction
      </a>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/admin" class="block px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors">
          Admin Dashboard
        </a>
      <% } %>
      <a href="/profile" class="block px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors">
        Profile
      </a>
      <button type="button" onclick="toggleTheme()" class="w-full text-left px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-emerald-400 transition-colors flex items-center gap-2">
        <svg class="theme-icon-sun w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg class="theme-icon-moon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        Day / Night mode
      </button>
      <form method="POST" action="/logout">
        <button type="submit" class="w-full text-left px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-red-400 transition-colors">
          Log out
        </button>
      </form>
    </div>
  </div>
</nav>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">

<script>
function toggleMobileMenu() {
  const menu = document.getElementById('mobile-menu');
  menu.classList.toggle('hidden');
}
</script>
