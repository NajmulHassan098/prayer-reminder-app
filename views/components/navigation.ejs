<%
/*
 * Redesigned top navigation — three zones (brand / primary / utilities), a
 * More popover for secondary pages, a profile popover for account actions,
 * and a mobile bottom tab bar with a full-height sheet for the extras.
 *
 * Server-rendered active state (via res.locals.currentPath set in the auth
 * middleware) means aria-current is present on the first paint — no JS, no
 * flash. Progressive enhancement for popovers/sheet/countdown lives in
 * public/nav.js. All visuals read from CSS custom properties (see
 * public/style.css — "NAVIGATION" section) so light/dark and RTL fall out of
 * the tokens, not per-utility overrides.
 *
 * Variables this partial may receive (all optional except user):
 *   user        — { name, group_id, ... }
 *   isAdmin     — boolean; gates the Admin link
 *   showSearch  — boolean; renders the member-search pill (dashboard sets true)
 *   hijriToday  — string; nav sub-line (auth middleware)
 *   currentPath — string; marks the active link (auth middleware)
 *   locale, dir — for RTL awareness (auth middleware)
 */

const CP = (typeof currentPath !== 'undefined' && currentPath) || '';
const U  = (typeof user !== 'undefined' && user) ? user : null;
const IS_ADMIN = (typeof isAdmin !== 'undefined' && isAdmin);
const SHOW_SEARCH = (typeof showSearch !== 'undefined' && showSearch);

// Single consistent icon set — 24×24 grid, 1.75 stroke, currentColor. Kept
// hand-authored (matches the existing project convention: no icon library).
const ICONS = {
  home:     '<path d="M3 10.5 12 3l9 7.5V20a2 2 0 0 1-2 2h-3.5v-6h-7V22H5a2 2 0 0 1-2-2z"/>',
  clock:    '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.5 2"/>',
  bars:     '<path d="M4 20h16"/><path d="M7 16v-4"/><path d="M12 16V7"/><path d="M17 16v-7"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="16" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10.5h17"/><path d="M9 14.5h2M13.5 17.5H16"/>',
  beads:    '<path d="M12 4a7 7 0 0 1 5.9 8.95"/><path d="M6.1 12.95A7 7 0 0 1 12 4"/><circle cx="12" cy="4" r="1.25" fill="currentColor" stroke="none"/><circle cx="17.9" cy="8" r="1.25" fill="currentColor" stroke="none"/><circle cx="18.6" cy="14.2" r="1.25" fill="currentColor" stroke="none"/><circle cx="5.4" cy="14.2" r="1.25" fill="currentColor" stroke="none"/><circle cx="6.1" cy="8" r="1.25" fill="currentColor" stroke="none"/><path d="M12 12v6"/><circle cx="12" cy="19.5" r="1.5" fill="currentColor" stroke="none"/>',
  compass:  '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
  refresh:  '<path d="M4 4v5h5"/><path d="M20 20v-5h-5"/><path d="M4.5 9A8 8 0 0 1 18.5 6.5L20 9"/><path d="M19.5 15A8 8 0 0 1 5.5 17.5L4 15"/>',
  gear:     '<circle cx="12" cy="12" r="3"/><path d="M10.4 3.6l-.5 1.9a1.7 1.7 0 0 1-2.7 1L5.4 5.9 3.6 9l1.6 1.1a1.7 1.7 0 0 1 0 2.8L3.6 14l1.8 3.1 1.8-.6a1.7 1.7 0 0 1 2.7 1l.5 1.9h3.6l.5-1.9a1.7 1.7 0 0 1 2.7-1l1.8.6 1.8-3.1-1.6-1.1a1.7 1.7 0 0 1 0-2.8l1.6-1.1-1.8-3.1-1.8.6a1.7 1.7 0 0 1-2.7-1l-.5-1.9z"/>',
  users:    '<path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20"/><circle cx="9.5" cy="8" r="3.25"/><path d="M17 11a3.25 3.25 0 1 0 0-6.5"/><path d="M21 20v-1.5a4 4 0 0 0-3-3.87"/>',
  search:   '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/>',
  ellipsis: '<circle cx="6" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="18" cy="12" r="1.5" fill="currentColor" stroke="none"/>',
  hamburger:'<path d="M4 7h16M4 12h16M4 17h16"/>',
  close:    '<path d="M6 6l12 12M18 6L6 18"/>',
  chevron:  '<path d="M6 9l6 6 6-6"/>',
  sun:      '<circle cx="12" cy="12" r="4"/><path d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1.05 1.05M17.35 17.35l1.05 1.05M5.6 18.4l1.05-1.05M17.35 6.65l1.05-1.05"/>',
  moon:     '<path d="M20 12.4A8 8 0 1 1 11.6 4a6.5 6.5 0 0 0 8.4 8.4z"/>',
  user:     '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  bell:     '<path d="M6 8a6 6 0 1 1 12 0v5l1.5 3H4.5L6 13z"/><path d="M10 19a2 2 0 0 0 4 0"/>',
  logout:   '<path d="M15 17l4-5-4-5"/><path d="M19 12H9"/><path d="M12 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6"/>',
  mosque:   '<path d="M12 3c2 3 3 4 3 6a3 3 0 0 1-6 0c0-2 1-3 3-6z"/><path d="M4 21v-6a8 8 0 0 1 16 0v6"/><path d="M2 21h20"/><path d="M9 21v-3a3 3 0 0 1 6 0v3"/>',
};
function icon(name, extraClass) {
  return '<svg class="nav-ic ' + (extraClass || '') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" '
       + 'stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (ICONS[name] || '') + '</svg>';
}
function isActive(href) {
  // Match either exact or a nested subpath (e.g., /admin/member/1 still marks Admin).
  return CP === href || (CP.length > href.length && CP.startsWith(href + '/'));
}

// Six primary pages — the maximum the brief allows in the primary row.
const PRIMARY = [
  { href: '/dashboard', label: 'Dashboard', icon: 'home',     title: 'Your day at a glance' },
  { href: '/times',     label: 'Today',     icon: 'clock',    title: 'Live countdown, today\'s schedule and Tahajjud' },
  { href: '/weekly',    label: 'Weekly',    icon: 'bars',     title: 'Weekly progress and streaks' },
  { href: '/hijri',     label: 'Hijri',     icon: 'calendar', title: 'Islamic calendar with commemorations' },
  { href: '/tasbeeh',   label: 'Tasbeeh',   icon: 'beads',    title: 'Dhikr counter' },
  { href: '/qibla',     label: 'Qibla',     icon: 'compass',  title: 'Find the Qibla direction' },
];

// Utilities that live in the More popover on desktop / the sheet on mobile.
const SECONDARY = [
  { href: '/calendar', label: 'Sync (.ics feed)', icon: 'refresh', title: 'Subscribe to your prayer times in Google/Apple/Outlook' },
];
if (U && U.group_id) SECONDARY.push({ href: '/group/activity', label: 'Group activity', icon: 'users', title: 'See how your group is doing' });
if (IS_ADMIN)        SECONDARY.push({ href: '/admin',          label: 'Admin',          icon: 'gear',  title: 'Manage members' });

// Mobile tab bar: the four most-used pages + More.
const TABS = PRIMARY.filter(p => ['/dashboard','/times','/weekly','/hijri'].includes(p.href));

const avatarLetter = U && U.name ? U.name.charAt(0).toUpperCase() : 'U';
%>

<header id="topnav" class="topnav" data-scrolled="false">
  <div class="topnav-inner">

    <a class="nav-brand" href="/dashboard" aria-label="Prayer Reminder — home">
      <span class="nav-brand-mark" aria-hidden="true"><%- icon('mosque') %></span>
      <span class="nav-brand-text">
        <span class="nav-brand-title">Prayer Reminder</span>
        <% if (typeof hijriToday !== 'undefined' && hijriToday) { %>
          <span class="nav-brand-sub" title="Today's Hijri date (civil-day convention)">
            <span aria-hidden="true" class="nav-brand-sub-ic"><%- icon('moon') %></span>
            <span class="nav-brand-sub-txt"><%= hijriToday %> AH</span>
          </span>
        <% } %>
      </span>
    </a>

    <nav class="nav-primary" aria-label="Primary">
      <ul class="nav-primary-list">
        <% PRIMARY.forEach(function(item){ %>
          <li>
            <a href="<%= item.href %>"
               class="nav-link<%= isActive(item.href) ? ' is-current' : '' %>"
               <% if (isActive(item.href)) { %>aria-current="page"<% } %>
               title="<%= item.title %>">
              <%- icon(item.icon) %>
              <span class="nav-link-label"><%= item.label %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    </nav>

    <div class="nav-utils">

      <a href="/times" class="nav-chip" id="next-prayer" hidden
         title="Countdown to your next prayer">
        <span class="nav-chip-dot" aria-hidden="true"></span>
        <span class="nav-chip-body" aria-live="polite">
          <span class="nav-chip-name" id="np-name">—</span>
          <span class="nav-chip-time" id="np-time"></span>
        </span>
      </a>

      <% if (SHOW_SEARCH) { %>
        <div class="nav-search" id="nav-search" data-open="false">
          <button type="button"
                  class="nav-icon-btn nav-search-toggle"
                  aria-expanded="false" aria-controls="nav-search-field"
                  aria-label="Search group members" title="Search group members">
            <%- icon('search') %>
          </button>
          <div class="nav-search-field member-search" id="nav-search-field" hidden>
            <input type="text" placeholder="Search a member…"
                   autocomplete="off" aria-label="Search group members by name" />
          </div>
        </div>
      <% } %>

      <div class="nav-pop-wrap">
        <button type="button"
                class="nav-icon-btn"
                data-nav-pop="more-menu" aria-expanded="false" aria-controls="more-menu"
                aria-label="More pages" title="More">
          <%- icon('ellipsis') %>
        </button>
        <div id="more-menu" class="nav-pop nav-pop--right" role="menu" hidden>
          <p class="nav-pop-heading">Utilities</p>
          <% SECONDARY.forEach(function(item){ %>
            <a role="menuitem" href="<%= item.href %>"
               class="nav-pop-item<%= isActive(item.href) ? ' is-current' : '' %>"
               <% if (isActive(item.href)) { %>aria-current="page"<% } %>>
              <%- icon(item.icon) %><span><%= item.label %></span>
            </a>
          <% }); %>
          <% if (SHOW_SEARCH) { %>
            <button type="button" class="nav-pop-item nav-pop-search-trigger" data-open-search>
              <%- icon('search') %><span>Search members</span>
            </button>
          <% } %>
        </div>
      </div>

      <button type="button"
              class="nav-icon-btn nav-theme-btn"
              onclick="toggleTheme()"
              aria-label="Toggle day / night mode" title="Toggle day / night mode">
        <span class="theme-icon-sun nav-theme-ic"><%- icon('sun') %></span>
        <span class="theme-icon-moon nav-theme-ic"><%- icon('moon') %></span>
      </button>

      <div class="nav-pop-wrap">
        <button type="button"
                class="nav-avatar-btn"
                data-nav-pop="profile-menu" aria-expanded="false" aria-controls="profile-menu"
                aria-label="Account menu" title="Account">
          <span class="nav-avatar" aria-hidden="true"><%= avatarLetter %></span>
          <span class="nav-avatar-chev" aria-hidden="true"><%- icon('chevron') %></span>
        </button>
        <div id="profile-menu" class="nav-pop nav-pop--right" role="menu" hidden>
          <% if (U && U.name) { %>
            <p class="nav-pop-heading">Signed in as <strong><%= U.name %></strong></p>
          <% } else { %>
            <p class="nav-pop-heading">Account</p>
          <% } %>
          <a role="menuitem" href="/profile" class="nav-pop-item<%= isActive('/profile') ? ' is-current' : '' %>">
            <%- icon('user') %><span>Profile &amp; settings</span>
          </a>
          <a role="menuitem" href="/notifications" class="nav-pop-item<%= isActive('/notifications') ? ' is-current' : '' %>">
            <%- icon('bell') %><span>Notification preferences</span>
          </a>
          <hr class="nav-pop-sep" />
          <form method="POST" action="/logout" class="nav-pop-form">
            <button type="submit" role="menuitem" class="nav-pop-item nav-pop-danger">
              <%- icon('logout') %><span>Log out</span>
            </button>
          </form>
        </div>
      </div>

      <button type="button"
              class="nav-icon-btn nav-burger"
              data-nav-pop="nav-sheet" aria-expanded="false" aria-controls="nav-sheet"
              aria-label="Open menu" title="Menu">
        <%- icon('hamburger') %>
      </button>

    </div>
  </div>
</header>

<nav class="tabbar" aria-label="Primary (mobile)">
  <ul class="tabbar-list">
    <% TABS.forEach(function(item){ %>
      <li>
        <a class="tab<%= isActive(item.href) ? ' is-current' : '' %>"
           href="<%= item.href %>"
           <% if (isActive(item.href)) { %>aria-current="page"<% } %>>
          <%- icon(item.icon) %>
          <span class="tab-label"><%= item.label %></span>
        </a>
      </li>
    <% }); %>
    <li>
      <button type="button" class="tab tab--more"
              data-nav-pop="nav-sheet" aria-expanded="false" aria-controls="nav-sheet">
        <%- icon('ellipsis') %>
        <span class="tab-label">More</span>
      </button>
    </li>
  </ul>
</nav>

<div class="nav-sheet-wrap" id="nav-sheet-wrap" hidden>
  <div class="nav-sheet-backdrop" data-nav-dismiss></div>
  <div id="nav-sheet" class="nav-sheet" role="dialog" aria-modal="true" aria-label="All pages" tabindex="-1">
    <div class="nav-sheet-header">
      <span class="nav-sheet-title">Menu</span>
      <button type="button" class="nav-icon-btn" data-nav-dismiss aria-label="Close menu">
        <%- icon('close') %>
      </button>
    </div>
    <div class="nav-sheet-body">
      <p class="nav-sheet-heading">Pages</p>
      <ul class="nav-sheet-list">
        <% PRIMARY.concat(SECONDARY).forEach(function(item){ %>
          <li>
            <a class="nav-sheet-item<%= isActive(item.href) ? ' is-current' : '' %>"
               href="<%= item.href %>"
               <% if (isActive(item.href)) { %>aria-current="page"<% } %>>
              <%- icon(item.icon) %><span><%= item.label %></span>
            </a>
          </li>
        <% }); %>
      </ul>
      <p class="nav-sheet-heading">Account</p>
      <ul class="nav-sheet-list">
        <li>
          <a class="nav-sheet-item" href="/profile">
            <%- icon('user') %><span>Profile &amp; settings</span>
          </a>
        </li>
        <li>
          <a class="nav-sheet-item" href="/notifications">
            <%- icon('bell') %><span>Notification preferences</span>
          </a>
        </li>
        <li>
          <button type="button" class="nav-sheet-item nav-sheet-btn" onclick="toggleTheme()">
            <span class="theme-icon-sun nav-theme-ic"><%- icon('sun') %></span>
            <span class="theme-icon-moon nav-theme-ic"><%- icon('moon') %></span>
            <span>Toggle day / night</span>
          </button>
        </li>
        <li>
          <form method="POST" action="/logout" class="nav-sheet-form">
            <button type="submit" class="nav-sheet-item nav-sheet-btn nav-pop-danger">
              <%- icon('logout') %><span>Log out</span>
            </button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</div>

<script src="/nav.js" defer></script>
