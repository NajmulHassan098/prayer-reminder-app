<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Prayer Reminder — Never miss a Salah</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">
      <!-- Standalone landing page: stays dark by design (no theme toggle here). -->
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">

  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-xl border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/30">
            <span class="text-white text-xl">🕌</span>
          </div>
          <span class="text-xl font-bold text-white">Prayer Reminder</span>
        </div>
        <div class="flex items-center gap-3">
          <a href="/login" class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-200 ring-1 ring-inset ring-slate-700 hover:bg-slate-800 transition-colors">Log in</a>
          <a href="/register" class="px-4 py-2 rounded-xl text-sm font-semibold bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/20 transition-colors">Sign up</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <header class="relative pt-40 pb-28 px-4 text-center overflow-hidden">
    <div class="max-w-3xl mx-auto">
      <span class="inline-block text-xs font-bold tracking-wider uppercase text-emerald-300 bg-emerald-500/10 ring-1 ring-inset ring-emerald-500/30 px-3 py-1 rounded-full mb-6">Salah, on time — together</span>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white leading-tight tracking-tight mb-6">
        Pray on time, <span class="bg-gradient-to-r from-emerald-400 to-teal-400 bg-clip-text text-transparent">together.</span>
      </h1>
      <p class="text-slate-400 text-lg leading-relaxed max-w-2xl mx-auto mb-10">
        Create or join a small group, and get an email the moment each prayer
        starts — timed to your own city, adjusted automatically every day as
        sunrise and sunset shift.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/register" class="px-8 py-4 rounded-xl font-semibold bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/30 transition-all transform hover:scale-[1.02]">Get started — it's free</a>
        <a href="/login" class="px-8 py-4 rounded-xl font-semibold text-slate-200 ring-1 ring-inset ring-slate-700 hover:bg-slate-800 transition-colors">I already have an account</a>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

    <!-- Features -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-24">
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20 transition-colors hover:border-emerald-500/40">
        <div class="text-3xl mb-4">🌍</div>
        <h3 class="text-white font-bold text-lg mb-2">Works anywhere</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Times are calculated for each person's own city — Karachi, Lahore, London, wherever your group is.</p>
      </div>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20 transition-colors hover:border-emerald-500/40">
        <div class="text-3xl mb-4">🔄</div>
        <h3 class="text-white font-bold text-lg mb-2">Always up to date</h3>
        <p class="text-slate-400 text-sm leading-relaxed">No manual updates. Times are re-fetched daily, so they naturally follow the shift in sunset and sunrise.</p>
      </div>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20 transition-colors hover:border-emerald-500/40">
        <div class="text-3xl mb-4">✉️</div>
        <h3 class="text-white font-bold text-lg mb-2">Gentle reminders</h3>
        <p class="text-slate-400 text-sm leading-relaxed">An email when it's time to pray, and a short follow-up afterwards asking if you did.</p>
      </div>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20 transition-colors hover:border-emerald-500/40">
        <div class="text-3xl mb-4">👥</div>
        <h3 class="text-white font-bold text-lg mb-2">Small, private groups</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Create a group with a permanent join code (up to 30 people), or join one you've been invited to.</p>
      </div>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20 transition-colors hover:border-emerald-500/40">
        <div class="text-3xl mb-4">📊</div>
        <h3 class="text-white font-bold text-lg mb-2">Group accountability</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Group admins can see who's keeping up with their prayers, encouraging consistency together.</p>
      </div>
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20 transition-colors hover:border-emerald-500/40">
        <div class="text-3xl mb-4">🔒</div>
        <h3 class="text-white font-bold text-lg mb-2">Simple &amp; private</h3>
        <p class="text-slate-400 text-sm leading-relaxed">Just an email and a city — nothing else needed to get started.</p>
      </div>
    </section>

    <!-- Quotes -->
    <section class="mb-24">
      <h2 class="text-3xl font-bold text-white text-center mb-3">A reminder about Salah</h2>
      <p class="text-slate-400 text-center max-w-xl mx-auto mb-12">A few words on prayer from the Qur'an and Hadith.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <% reminders.forEach(function(r) { %>
          <div class="bg-slate-900/60 backdrop-blur border border-slate-800 border-l-4 border-l-emerald-500 rounded-2xl p-6 shadow-xl shadow-black/20">
            <span class="inline-block text-xs font-bold tracking-wider uppercase text-emerald-300 bg-emerald-500/10 ring-1 ring-inset ring-emerald-500/30 px-3 py-1 rounded-full mb-4"><%= r.type %></span>
            <p class="text-slate-200 italic leading-relaxed mb-4">&ldquo;<%= r.text %>&rdquo;</p>
            <p class="text-slate-500 text-sm">— <%= r.reference %></p>
          </div>
        <% }); %>
      </div>
      <p class="text-slate-500 text-xs text-center mt-8 max-w-2xl mx-auto">
        Translations shown here are commonly-cited renderings intended as a gentle reminder,
        not a scholarly reference — please verify exact wording against
        <a href="https://quran.com" target="_blank" rel="noopener" class="text-emerald-400 hover:text-emerald-300">quran.com</a> or
        <a href="https://sunnah.com" target="_blank" rel="noopener" class="text-emerald-400 hover:text-emerald-300">sunnah.com</a>.
      </p>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-br from-emerald-600 to-teal-700 rounded-3xl p-12 text-center shadow-xl shadow-emerald-900/30 ring-1 ring-inset ring-white/10">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-8">Ready to keep each other consistent?</h2>
      <a href="/register" class="inline-block px-8 py-4 rounded-xl font-semibold bg-white text-emerald-700 shadow-lg transition-all transform hover:scale-[1.02]">Create your account</a>
    </section>

  </main>

  <%- include('components/footer', { isAdmin: false }) %>

</body>
</html>
