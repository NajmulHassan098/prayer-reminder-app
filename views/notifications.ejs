<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Email preferences — Prayer Reminder</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;700&display=swap" rel="stylesheet">
  <script src="/theme.js"></script>
    <link rel="stylesheet" href="/style.css" />
</head>
<body class="bg-slate-950 min-h-screen text-slate-100 antialiased" style="background-image: radial-gradient(60rem 60rem at 110% -10%, rgba(16,185,129,0.10), transparent 60%), radial-gradient(50rem 50rem at -10% 10%, rgba(99,102,241,0.10), transparent 55%);">
  <%- include('components/navigation', { user, isAdmin: false }) %>
  <div class="container mx-auto px-4 pt-24 pb-12 max-w-2xl">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white mb-1">Email preferences</h1>
      <p class="text-slate-400">Choose which prayers we email you about, and whether you want the reminder before the prayer, the check-in after it, or both.</p>
    </div>

    <% if (saved) { %>
      <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 rounded-2xl p-4 mb-6 flex items-start gap-3">
        <span class="text-lg leading-none mt-0.5">✓</span>
        <p class="font-semibold">Your preferences have been saved.</p>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="bg-red-500/10 border border-red-500/30 text-red-300 rounded-2xl p-4 mb-6">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/notifications" class="space-y-6">

      <!-- Which emails to send -->
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
        <h2 class="text-lg font-bold text-white mb-1">Email types</h2>
        <p class="text-slate-400 text-sm mb-4">We can nudge you before a prayer and follow up after it.</p>

        <label class="flex items-start gap-3 py-2 cursor-pointer">
          <input type="checkbox" name="pre" <%= prefs.pre ? 'checked' : '' %>
                 class="mt-1 w-5 h-5 rounded bg-slate-800 border-slate-600 text-emerald-500 focus:ring-emerald-500 focus:ring-2">
          <span>
            <span class="block text-slate-100 font-medium">Before prayer — “time to prepare”</span>
            <span class="block text-slate-400 text-sm">Sent a few minutes ahead of each prayer you've enabled below.</span>
          </span>
        </label>

        <label class="flex items-start gap-3 py-2 cursor-pointer border-t border-slate-800 mt-2 pt-4">
          <input type="checkbox" name="post" <%= prefs.post ? 'checked' : '' %>
                 class="mt-1 w-5 h-5 rounded bg-slate-800 border-slate-600 text-emerald-500 focus:ring-emerald-500 focus:ring-2">
          <span>
            <span class="block text-slate-100 font-medium">After prayer — “did you pray?” check-in</span>
            <span class="block text-slate-400 text-sm">Sent a little while after the prayer with a one-tap yes / no.</span>
          </span>
        </label>
      </div>

      <!-- Which prayers -->
      <div class="bg-slate-900/60 backdrop-blur border border-slate-800 rounded-2xl p-6 shadow-xl shadow-black/20">
        <h2 class="text-lg font-bold text-white mb-1">Prayers</h2>
        <p class="text-slate-400 text-sm mb-4">Turn emails off for a prayer you don't need reminding about.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% ['Fajr','Dhuhr','Asr','Maghrib','Isha'].forEach(function(name){ %>
            <label class="flex items-center gap-3 px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl cursor-pointer hover:border-emerald-500/50 transition-colors">
              <input type="checkbox" name="prayer_<%= name %>" <%= prefs.prayers[name] ? 'checked' : '' %>
                     class="w-5 h-5 rounded bg-slate-800 border-slate-600 text-emerald-500 focus:ring-emerald-500 focus:ring-2">
              <span class="text-slate-100 font-semibold"><%= name %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <button type="submit"
              class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold rounded-xl shadow-lg shadow-emerald-500/20 transition-all">
        Save preferences
      </button>

      <p class="text-slate-500 text-xs text-center">
        Your group's prayer log still records your responses regardless of these email settings.
      </p>
    </form>

    <div class="mt-6 text-center">
      <a href="/dashboard" class="text-slate-400 hover:text-emerald-400 transition-colors">&larr; Back to dashboard</a>
    </div>

  </div>
</body>
</html>
