# Copy this file to ".env" and fill in your real values before running the app.

# Port the web server runs on
PORT=3000

# Random long random string used to sign sessions and response-link tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string
TOKEN_SECRET=change_this_to_a_different_long_random_string

# Public base URL of your deployed site (used inside email links).
# For local testing this is fine as-is.
BASE_URL=http://localhost:3000

# --- Supabase Configuration ---
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Fallback Aladhan calculation method id, used only for countries not covered by
# the built-in per-country map in src/services/prayerTimes.js (1 = Karachi).
# The app now picks the right method automatically from each user's country so
# Fajr/Isha match their local region; this value is just the safety net.
# Full list: https://aladhan.com/prayer-times-api  (see "Methods")
PRAYER_CALC_METHOD=1

# --- Email (SMTP) settings ---
# Any SMTP provider works: Gmail (with an App Password), SendGrid, Mailtrap, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Prayer Reminder <your_email@gmail.com>"

# How many minutes BEFORE the prayer time to send the "time to prepare" reminder email
PRE_REMINDER_MINUTES=30

# How many minutes after the prayer time to send the "Did you pray?" follow-up email
FOLLOWUP_DELAY_MINUTES=30

# How many minutes after the prayer time to auto-mark a prayer "missed" if no response
# (the scheduler also pulls this in to finish just before the next prayer begins)
MISSED_AFTER_MINUTES=120

# Send window (minutes) for every email: a pre-reminder or follow-up is only
# sent while scheduledAt <= now < scheduledAt + SEND_GRACE_MINUTES. Once the
# window closes (late tick after a restart/downtime/SMTP failure) the email is
# logged as 'skipped_stale' in notifications_log and never sent or retried.
# Default 10 = two 5-minute scheduler ticks.
SEND_GRACE_MINUTES=10

# --- Production Cron Job Settings ---
# Set this to use external cron services (Vercel Cron, GitHub Actions, etc.) instead of internal node-cron
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If set, the internal scheduler is disabled and you must call POST /api/cron/prayer-scheduler with Bearer token
# Leave empty for development (uses internal node-cron scheduler)
CRON_SECRET=
